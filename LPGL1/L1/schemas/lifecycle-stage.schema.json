{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "al1.schema.lpg-l1.lifecycle-stage",
  "_comment": "INERT DRAFT. Contract only. No runtime reads or writes this yet. Refinement notes: stage granularity may later split per subtier (lpg-l1.l2.environment.python312) rather than per tier band; stage ordering may later become partially parallel once dependency edges are proven acyclic per band.",
  "title": "AL1/LPG-L1 Lifecycle Stage Record",
  "description": "Ordered install/setup stage with tier band, entry criteria, exit validation, and known-good binding. A stage that fails validation must not be recorded as complete or known-good. Use kind=definition for a declared stage template; use kind=record for a stage that has actually run and therefore carries state and observed results.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "kind",
    "stage_id",
    "tier",
    "title",
    "purpose",
    "entry_criteria",
    "operations",
    "exit_validation",
    "status"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "const": "lpg-l1" },
    "kind": { "type": "string", "enum": ["definition", "record"] },
    "stage_id": { "type": "string", "minLength": 1 },
    "order": { "type": "integer", "minimum": 0 },
    "tier": { "type": "string", "enum": ["L1", "L2", "L3", "L4", "L5", "L6"] },
    "subtier": { "type": ["string", "null"] },
    "title": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "entry_criteria": { "type": "array", "items": { "$ref": "#/$defs/criterion" } },
    "operations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "exit_validation": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/criterion" } },
    "known_good_record": { "type": ["string", "null"] },
    "reversible": { "type": "boolean" },
    "requires_approval": { "type": "boolean" },
    "depends_on": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "status": {
      "type": "string",
      "enum": ["planned", "in-progress", "validated", "failed", "skipped", "stale"]
    },
    "status_reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "surfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/surface" }
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "check": { "type": ["string", "null"] },
        "required": { "type": "boolean" },
        "observed_result": {
          "type": ["string", "null"],
          "enum": ["pass", "fail", "partial", "not-run", null]
        },
        "evidence": { "type": ["string", "null"] }
      }
    },
    "surface": {
      "type": "string",
      "enum": ["windows-wizard", "cli", "tui", "web", "desktop", "mcp", "ai-agent"]
    }
  }
}
