{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "al1.schema.lpg-l1.component-manifest",
  "title": "AL1/LPG-L1 Component Manifest",
  "description": "Canonical contract for a recursive LPG-L1 component, subtier, program, shell, contract, or artifact node. Paths are root-relative unless explicitly marked runtime-resolved.",
  "type": "object",
  "additionalProperties": false,
  "required": ["identity", "tier", "status", "paths"],
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profile", "kind", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "description": "Stable language-neutral machine identity, for example lpg-l1.l3.program.forge."
        },
        "profile": {
          "type": "string",
          "const": "lpg-l1"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        }
      }
    },
    "tier": {
      "type": "string",
      "enum": ["L1", "L2", "L3", "L4", "L5", "L6", "L12", "Unclassified"]
    },
    "subtier": {
      "type": ["string", "null"]
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "discovered",
        "observed",
        "partial",
        "validated",
        "active",
        "stale",
        "missing",
        "conflicting",
        "quarantined",
        "revoked",
        "unknown"
      ]
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "type": ["string", "null"] },
        "runtime": { "type": ["string", "null"] },
        "schema": { "type": ["string", "null"] },
        "entrypoint": { "type": ["string", "null"] },
        "output": { "type": ["string", "null"] }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "control_owner": { "type": ["string", "null"] },
        "runtime_owner": { "type": ["string", "null"] },
        "security_steward": { "type": ["string", "null"] },
        "data_owner": { "type": ["string", "null"] },
        "maintainer": { "type": ["string", "null"] }
      }
    },
    "representations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["format", "role", "path", "schema"],
        "properties": {
          "format": {
            "type": "string",
            "enum": ["json", "jsonc", "yaml", "yaml-c", "cbor", "cbor-ld"]
          },
          "role": {
            "type": "string",
            "enum": ["authoring", "canonical", "compiled", "runtime", "reference"]
          },
          "path": { "type": "string", "minLength": 1 },
          "schema": { "type": "string", "minLength": 1 },
          "digest": { "type": ["string", "null"] }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requires": { "type": "array", "items": { "type": "string" } },
        "provides": { "type": "array", "items": { "type": "string" } },
        "conflicts_with": { "type": "array", "items": { "type": "string" } },
        "optional": { "type": "array", "items": { "type": "string" } }
      }
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inherits": { "type": "array", "items": { "type": "string" } },
        "allows": { "type": "array", "items": { "type": "string" } },
        "denies": { "type": "array", "items": { "type": "string" } },
        "requires_approval": { "type": "array", "items": { "type": "string" } }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": { "type": ["string", "null"] },
        "smoke": { "type": "array", "items": { "type": "string" } },
        "dry_run": { "type": ["string", "null"] },
        "last_result": {
          "type": ["string", "null"],
          "enum": ["passed", "failed", "blocked", "partial", "unchecked", null]
        },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "setup": { "type": ["string", "null"] },
        "activate": { "type": ["string", "null"] },
        "refresh": { "type": ["string", "null"] },
        "repair": { "type": ["string", "null"] },
        "shutdown": { "type": ["string", "null"] },
        "rollback": { "type": ["string", "null"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "type": ["string", "null"] },
        "observed_at": { "type": ["string", "null"], "format": "date-time" },
        "generated_by": { "type": ["string", "null"] },
        "digest": { "type": ["string", "null"] }
      }
    },
    "children": {
      "type": "array",
      "items": { "$ref": "#" }
    },
    "x-al1": {
      "type": "object",
      "description": "Non-authoritative annotations. Never grants capabilities or changes policy.",
      "additionalProperties": true
    }
  }
}
