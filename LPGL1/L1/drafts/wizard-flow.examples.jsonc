    "install_task": {
      "schema_version": "0.1.0-alpha.1",
      "profile": "lpg-l1",
      "task_id": "prog.build-native-geometry",
      "stage_id": "lpg-l1.stage.l3.programs",
      "tier": "L3",
      "component_id": "lpg-l1.l3.program.forge_native",
      "kind": "rebuild",
      "title": "Build the native geometry binding",
      "explanation": "The Rust geometry crate is present and its test suite passes, but the Python extension module is not built for the current CPython ABI.",
      "adapter": "python-pyo3",
      "risk": "medium",
      "fault_class": "missing",
      "reads": ["rust_core/", "Cargo.lock", ".venv312 environment"],
      "writes": [".al1-state/build/native", ".al1-state/artifacts/wheels"],
      "dry_run": true,
      "additive_only": true,
      "overwrites_existing": false,
      "requires_approval": true,
      "validation": [
        { "id": "cargo-test", "description": "Rust geometry suite passes", "check": "cargo test -p rust_core", "required": true, "result": null, "evidence": null },
        { "id": "native-import", "description": "Native module imports under Python 3.12", "check": "python -c 'import vaultmind_forge.native'", "required": true, "result": null, "evidence": null },
        { "id": "mesh-smoke", "description": "A known mesh round-trips through the binding", "check": "forge native-smoke", "required": true, "result": null, "evidence": null }
