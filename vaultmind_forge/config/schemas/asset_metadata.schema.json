{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vaultmind-forge.io/schemas/asset-metadata.json",
  "title": "Asset Metadata Schema",
  "description": "Complete metadata schema for ingested 3D assets, textures, and related files",
  "type": "object",
  "required": ["asset_id", "filename", "timestamp", "stage", "category"],
  "properties": {
    "asset_id": {
      "type": "string",
      "description": "SHA256 hash of the original file, serving as unique identifier",
      "pattern": "^[a-f0-9]{64}$"
    },
    "filename": {
      "type": "string",
      "description": "Original filename as downloaded"
    },
    "original_path": {
      "type": "string",
      "description": "Full path to original file location"
    },
    "file_size": {
      "type": "integer",
      "description": "File size in bytes",
      "minimum": 0
    },
    "file_type": {
      "type": "string",
      "description": "File extension (e.g., .zip, .fbx, .obj)",
      "pattern": "^\\.[a-z0-9]+$"
    },
    "stage": {
      "type": "string",
      "description": "Current pipeline stage",
      "enum": ["raw", "extracted", "classified", "validated", "enhanced", "converted", "cataloged"]
    },
    "category": {
      "type": "string",
      "description": "Primary asset category",
      "enum": [
        "characters",
        "vehicles",
        "weapons",
        "buildings",
        "nature",
        "props",
        "environments",
        "effects",
        "animals",
        "architecture",
        "furniture",
        "uncategorized"
      ]
    },
    "quality": {
      "type": "string",
      "description": "Estimated quality/fidelity level",
      "enum": ["unknown", "low", "medium", "high", "ultra"]
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of when asset was ingested",
      "format": "date-time"
    },
    "is_archive": {
      "type": "boolean",
      "description": "Whether file is an archive (zip, rar, etc.)"
    },
    "archive_contents": {
      "type": "array",
      "description": "List of files inside archive (if applicable)",
      "items": {
        "type": "string"
      }
    },
    "extracted_formats": {
      "type": "array",
      "description": "Unique file formats found in archive",
      "items": {
        "type": "string"
      }
    },
    "model_formats": {
      "type": "array",
      "description": "3D model formats present (.obj, .fbx, etc.)",
      "items": {
        "type": "string",
        "enum": [
          ".obj", ".fbx", ".gltf", ".glb", ".dae", ".blend",
          ".c4d", ".ma", ".mb", ".max", ".3ds", ".stl",
          ".ply", ".x3d", ".usd", ".usda", ".usdc", ".usdz"
        ]
      }
    },
    "has_textures": {
      "type": "boolean",
      "description": "Whether asset includes texture files"
    },
    "has_materials": {
      "type": "boolean",
      "description": "Whether asset includes material definitions"
    },
    "has_animations": {
      "type": "boolean",
      "description": "Whether asset includes animations"
    },
    "has_rigging": {
      "type": "boolean",
      "description": "Whether asset includes rigging/skeleton"
    },
    "inferred_type": {
      "type": "string",
      "description": "AI-inferred asset type (e.g., 'humanoid character', 'sci-fi vehicle')"
    },
    "inferred_category": {
      "type": "string",
      "description": "Secondary/refined category inference"
    },
    "polycount_estimate": {
      "type": "string",
      "description": "Estimated polygon count range (e.g., 'low-poly', 'high-poly')",
      "enum": ["unknown", "very-low", "low", "medium", "high", "very-high"]
    },
    "tags": {
      "type": "array",
      "description": "Searchable semantic tags for discovery",
      "items": {
        "type": "string"
      }
    },
    "engine_compatibility": {
      "type": "array",
      "description": "Game engines this asset is compatible with",
      "items": {
        "type": "string",
        "enum": ["unity", "unreal", "godot", "blender", "generic"]
      }
    },
    "usage_rights": {
      "type": "string",
      "description": "License or usage rights (if known)",
      "enum": ["unknown", "free", "personal", "commercial", "restricted"]
    },
    "source_url": {
      "type": "string",
      "description": "Original download URL (if tracked)",
      "format": "uri"
    }
  }
}
