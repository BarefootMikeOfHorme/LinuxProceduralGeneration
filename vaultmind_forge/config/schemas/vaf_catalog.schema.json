{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vaultmind-forge.io/schemas/vaf-catalog.json",
  "title": "VAF-Catalog Schema",
  "description": "Lightweight catalog format for fast asset discovery and indexing",
  "type": "object",
  "required": ["vaf_type", "vaf_version", "asset_id", "name", "category", "created"],

  "properties": {
    "vaf_type": {
      "type": "string",
      "const": "catalog",
      "description": "VAF format type identifier"
    },

    "vaf_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "default": "1.0.0",
      "description": "VAF schema version"
    },

    "asset_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Unique SHA256 identifier"
    },

    "name": {
      "type": "string",
      "description": "Human-readable asset name"
    },

    "type": {
      "type": "string",
      "enum": ["model_3d", "texture", "material", "animation", "scene", "composite", "unknown"],
      "default": "model_3d",
      "description": "Primary asset type"
    },

    "category": {
      "type": "string",
      "enum": [
        "characters", "vehicles", "weapons", "buildings",
        "nature", "props", "environments", "effects",
        "animals", "architecture", "furniture", "robots",
        "uncategorized"
      ],
      "description": "Semantic category"
    },

    "subcategory": {
      "type": "string",
      "description": "Optional refined category (e.g., 'sci-fi robot', 'medieval sword')"
    },

    "tags": {
      "type": "array",
      "description": "Searchable tags",
      "items": {"type": "string"},
      "maxItems": 50
    },

    "description": {
      "type": "string",
      "maxLength": 500,
      "description": "Brief asset description"
    },

    "statistics": {
      "type": "object",
      "description": "Quick-reference statistics",
      "properties": {
        "vertices": {"type": "integer", "minimum": 0},
        "triangles": {"type": "integer", "minimum": 0},
        "materials": {"type": "integer", "minimum": 0},
        "textures": {"type": "integer", "minimum": 0},
        "animations": {"type": "integer", "minimum": 0},
        "bones": {"type": "integer", "minimum": 0}
      }
    },

    "quality": {
      "type": "string",
      "enum": ["unknown", "low", "medium", "high", "ultra"],
      "default": "unknown"
    },

    "polycount_category": {
      "type": "string",
      "enum": ["very-low", "low", "medium", "high", "very-high", "extreme"],
      "description": "Polygon count classification"
    },

    "formats": {
      "type": "object",
      "description": "Available format representations",
      "properties": {
        "source": {
          "type": "object",
          "description": "Original source format info",
          "properties": {
            "format": {"type": "string"},
            "filename": {"type": "string"},
            "size_bytes": {"type": "integer"}
          }
        },
        "vaf_full": {
          "type": "object",
          "description": "VAF-Full representation",
          "properties": {
            "path": {"type": "string"},
            "size_bytes": {"type": "integer"},
            "available": {"type": "boolean"}
          }
        },
        "vaf_binary": {
          "type": "object",
          "description": "VAF-Binary representation",
          "properties": {
            "path": {"type": "string"},
            "size_bytes": {"type": "integer"},
            "available": {"type": "boolean"}
          }
        },
        "engine_exports": {
          "type": "array",
          "description": "Engine-specific exports",
          "items": {
            "type": "object",
            "properties": {
              "engine": {"type": "string", "enum": ["unity", "unreal", "godot", "blender"]},
              "format": {"type": "string"},
              "path": {"type": "string"},
              "available": {"type": "boolean"}
            }
          }
        }
      }
    },

    "preview": {
      "type": "object",
      "description": "Preview/thumbnail references",
      "properties": {
        "thumbnail": {
          "type": "string",
          "description": "Path to thumbnail image (256x256)"
        },
        "preview_3d": {
          "type": "string",
          "description": "Path to low-poly preview model"
        }
      }
    },

    "capabilities": {
      "type": "object",
      "description": "Asset capabilities flags",
      "properties": {
        "has_geometry": {"type": "boolean"},
        "has_materials": {"type": "boolean"},
        "has_textures": {"type": "boolean"},
        "has_rigging": {"type": "boolean"},
        "has_animations": {"type": "boolean"},
        "has_lod": {"type": "boolean"}
      }
    },

    "engine_compatibility": {
      "type": "array",
      "description": "Compatible game engines",
      "items": {
        "type": "string",
        "enum": ["unity", "unreal", "godot", "blender", "generic"]
      }
    },

    "created": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp"
    },

    "modified": {
      "type": "string",
      "format": "date-time",
      "description": "Last modification timestamp"
    },

    "stage": {
      "type": "string",
      "enum": ["raw", "extracted", "classified", "validated", "enhanced", "converted", "cataloged"],
      "default": "raw",
      "description": "Pipeline stage"
    },

    "lineage": {
      "type": "object",
      "description": "Minimal lineage info",
      "properties": {
        "origin_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "parent": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "generation": {"type": "integer", "minimum": 0}
      }
    },

    "usage_rights": {
      "type": "object",
      "description": "License and usage information",
      "properties": {
        "license": {"type": "string"},
        "commercial_use": {"type": "boolean"},
        "attribution": {"type": "string"}
      }
    }
  }
}
