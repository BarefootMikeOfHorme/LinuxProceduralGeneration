{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaultmind.forge/schemas/optimization.schema.json",
  "title": "Asset Optimization Configuration",
  "description": "Defines optimization settings for asset processing pipeline",
  "type": "object",
  "required": ["optimization_id", "target_platform", "passes"],
  "properties": {
    "optimization_id": {
      "type": "string",
      "description": "Unique optimization profile identifier",
      "pattern": "^[a-z0-9_]+$"
    },
    "target_platform": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["desktop_high", "desktop_medium", "desktop_low", "mobile_high", "mobile_medium", "mobile_low", "web", "vr", "console"]
      },
      "description": "Target platforms for this optimization profile"
    },
    "priority": {
      "type": "string",
      "enum": ["quality", "performance", "balanced", "size"],
      "default": "balanced",
      "description": "Optimization priority focus"
    },
    "passes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/optimization_pass"
      },
      "description": "Sequential optimization passes to apply"
    },
    "mesh_optimization": {
      "type": "object",
      "properties": {
        "decimation": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "target_reduction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Target polygon reduction (0.0 = no reduction, 1.0 = maximum)"
            },
            "preserve_boundaries": { "type": "boolean", "default": true },
            "preserve_uvs": { "type": "boolean", "default": true },
            "preserve_normals": { "type": "boolean", "default": true },
            "algorithm": {
              "type": "string",
              "enum": ["quadric_error", "edge_collapse", "vertex_clustering"],
              "default": "quadric_error"
            }
          }
        },
        "welding": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "threshold": {
              "type": "number",
              "default": 0.0001,
              "description": "Distance threshold for vertex welding"
            }
          }
        },
        "normal_smoothing": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "angle_threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 180,
              "default": 30,
              "description": "Edge angle threshold for smooth/hard edges"
            }
          }
        },
        "tangent_generation": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "algorithm": {
              "type": "string",
              "enum": ["mikktspace", "legacy"],
              "default": "mikktspace"
            }
          }
        },
        "cache_optimization": {
          "type": "object",
          "properties": {
            "vertex_cache": { "type": "boolean", "default": true },
            "overdraw": { "type": "boolean", "default": false },
            "vertex_fetch": { "type": "boolean", "default": true }
          }
        }
      }
    },
    "texture_optimization": {
      "type": "object",
      "properties": {
        "resize": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "max_width": { "type": "integer", "default": 2048 },
            "max_height": { "type": "integer", "default": 2048 },
            "power_of_two": { "type": "boolean", "default": true },
            "filter": {
              "type": "string",
              "enum": ["lanczos", "bilinear", "bicubic", "nearest"],
              "default": "lanczos"
            }
          }
        },
        "compression": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "format_by_type": {
              "type": "object",
              "properties": {
                "diffuse": {
                  "type": "string",
                  "enum": ["bc7", "bc3", "bc1", "etc2", "astc", "webp", "jpg", "png"],
                  "default": "bc7"
                },
                "normal": {
                  "type": "string",
                  "enum": ["bc5", "bc3", "etc2", "astc", "png"],
                  "default": "bc5"
                },
                "data": {
                  "type": "string",
                  "enum": ["bc4", "bc1", "etc2", "png"],
                  "default": "bc4"
                }
              }
            },
            "quality": {
              "type": "string",
              "enum": ["low", "medium", "high", "max"],
              "default": "high"
            }
          }
        },
        "mipmap_generation": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "filter": {
              "type": "string",
              "enum": ["box", "triangle", "kaiser"],
              "default": "kaiser"
            },
            "levels": {
              "type": "integer",
              "minimum": 1,
              "description": "Number of mipmap levels (-1 = full chain)"
            }
          }
        },
        "channel_packing": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "packing_rules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "output_name": { "type": "string" },
                  "r": { "type": "string", "description": "Source texture for R channel" },
                  "g": { "type": "string", "description": "Source texture for G channel" },
                  "b": { "type": "string", "description": "Source texture for B channel" },
                  "a": { "type": "string", "description": "Source texture for A channel" }
                }
              }
            }
          }
        },
        "atlas_generation": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "max_atlas_size": { "type": "integer", "default": 4096 },
            "padding": { "type": "integer", "default": 2 },
            "power_of_two": { "type": "boolean", "default": true }
          }
        }
      }
    },
    "lod_generation": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "levels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["level", "reduction"],
            "properties": {
              "level": {
                "type": "integer",
                "minimum": 0,
                "description": "LOD level (0 = highest quality)"
              },
              "reduction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Polygon reduction percentage"
              },
              "screen_coverage": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Screen coverage percentage to switch to this LOD"
              },
              "texture_scale": {
                "type": "number",
                "minimum": 0.125,
                "maximum": 1.0,
                "default": 1.0,
                "description": "Texture resolution scale for this LOD"
              }
            }
          }
        },
        "algorithm": {
          "type": "string",
          "enum": ["quadric_error", "edge_collapse", "clustering"],
          "default": "quadric_error"
        }
      }
    },
    "animation_optimization": {
      "type": "object",
      "properties": {
        "keyframe_reduction": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "tolerance": {
              "type": "number",
              "default": 0.01,
              "description": "Maximum acceptable error"
            }
          }
        },
        "compression": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "algorithm": {
              "type": "string",
              "enum": ["acl", "simple", "none"],
              "default": "acl"
            }
          }
        }
      }
    },
    "quality_metrics": {
      "type": "object",
      "properties": {
        "min_acceptable_quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.8,
          "description": "Minimum quality score (0-1)"
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["visual_fidelity", "poly_count", "file_size", "texture_quality", "normal_consistency"]
          }
        },
        "auto_rollback": {
          "type": "boolean",
          "default": true,
          "description": "Rollback optimization if quality drops below threshold"
        }
      }
    },
    "batch_settings": {
      "type": "object",
      "properties": {
        "parallel_processing": {
          "type": "boolean",
          "default": true
        },
        "max_workers": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum parallel workers (-1 = auto)"
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1,
          "default": 10,
          "description": "Assets to process per batch"
        }
      }
    },
    "output_settings": {
      "type": "object",
      "properties": {
        "preserve_originals": {
          "type": "boolean",
          "default": true,
          "description": "Keep original files alongside optimized versions"
        },
        "output_suffix": {
          "type": "string",
          "default": "_optimized",
          "description": "Suffix for optimized files"
        },
        "generate_report": {
          "type": "boolean",
          "default": true,
          "description": "Generate optimization report"
        }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scenario", "settings", "expected_result"],
        "properties": {
          "scenario": { "type": "string" },
          "asset_type": { "type": "string" },
          "settings": { "type": "object" },
          "expected_result": {
            "type": "object",
            "properties": {
              "size_reduction": { "type": "string" },
              "quality_impact": { "type": "string" },
              "performance_gain": { "type": "string" }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "last_updated": { "type": "string", "format": "date" },
        "tested_platforms": {
          "type": "array",
          "items": { "type": "string" }
        },
        "references": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        },
        "maintainer": { "type": "string" }
      }
    }
  },
  "definitions": {
    "optimization_pass": {
      "type": "object",
      "required": ["pass_name", "operations"],
      "properties": {
        "pass_name": {
          "type": "string",
          "description": "Name of this optimization pass"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mesh_decimation",
              "vertex_welding",
              "normal_generation",
              "tangent_generation",
              "uv_optimization",
              "texture_compression",
              "texture_resize",
              "mipmap_generation",
              "lod_generation",
              "animation_compression",
              "cache_optimization"
            ]
          }
        },
        "order": {
          "type": "integer",
          "description": "Execution order of this pass"
        }
      }
    }
  }
}
