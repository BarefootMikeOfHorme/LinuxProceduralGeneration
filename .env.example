# VaultMind Forge API Configuration

# Server configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# CORS configuration
# Use '*' for development, specific origins for production
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info

# Python configuration (optional)
PYTHON_PATH=python3

# File upload limits (optional)
MAX_FILE_SIZE=52428800  # 50MB in bytes
MAX_FILES_PER_REQUEST=10

# Job execution timeouts (optional)
JOB_TIMEOUT=600000      # 10 minutes in ms
VALIDATION_TIMEOUT=60000  # 1 minute in ms
