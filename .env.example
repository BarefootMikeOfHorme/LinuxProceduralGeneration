# VaultMind Forge Configuration
# Copy to .env and customize for your environment

## Node.js API Server Configuration ##
# PORT: Auto-finds available port 1000-8000 if not set (avoids LM Studio/3000)
# Set explicitly if you want a fixed port
PORT=
HOST=0.0.0.0
NODE_ENV=development

# CORS configuration (use '*' for dev, specific origins for prod)
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info

# Python configuration
PYTHON_PATH=python3

# File upload limits
MAX_FILE_SIZE=52428800  # 50MB in bytes
MAX_FILES_PER_REQUEST=10

# Job execution timeouts (milliseconds)
JOB_TIMEOUT=600000      # 10 minutes
VALIDATION_TIMEOUT=60000  # 1 minute

## API Authentication ##
# IMPORTANT: Authentication is ENABLED by default for security
# Set to false ONLY for local development
VAULTMIND_AUTH_ENABLED=true
# Generate your API key: python -c "import secrets; print(secrets.token_urlsafe(32))"
VAULTMIND_API_KEY=your-secret-key-here-change-this

## Python CLI Configuration ##

# Paths (leave blank for auto-detection)
VAULTMIND_VENV_PATH=  # Auto-detects .venv312, .venv, or venv
VAULTMIND_MODELS_DIR=  # Default: PROJECT_ROOT/models
VAULTMIND_OUTPUT_DIR=  # Default: PROJECT_ROOT/output
VAULTMIND_CHECKPOINTS_DIR=  # Default: PROJECT_ROOT/checkpoints

# Generation defaults
VAULTMIND_DEFAULT_WIDTH=1024
VAULTMIND_DEFAULT_HEIGHT=1024
VAULTMIND_DEFAULT_STEPS=30

# Execution timeouts (seconds)
VAULTMIND_GENERATION_TIMEOUT=300
VAULTMIND_MAX_PARALLEL_TASKS=4

# AI Control preset (optional)
# Options: ai_full_autonomy, unity_export, mobile_optimization, fbx_to_gltf
VAULTMIND_AI_PRESET=

# Logging Configuration
VAULTMIND_LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
# Logs are automatically written to ./logs/ directory with rotation (10MB max, 5 backups)
# - api.log: All API logs
# - api_errors.log: Errors only
# - access.log: HTTP access logs
# - workflow.log: Workflow execution logs
# - cli.log: CLI logs

## Analytics & Telemetry ##
# Local analytics (always private, stored on your machine)
VAULTMIND_ANALYTICS_ENABLED=true
VAULTMIND_ANALYTICS_DB=./data/analytics.db

# Optional telemetry (disabled by default, fully opt-in)
# Sends anonymized usage statistics to help improve the product
# NO personally identifiable information is collected
VAULTMIND_TELEMETRY_ENABLED=false
VAULTMIND_TELEMETRY_ENDPOINT=

## Rate Limiting ##
# Use memory:// for single-instance deployments
# Use redis://localhost:6379 for distributed rate limiting (multiple instances)
RATE_LIMIT_STORAGE=memory://

## Security Configuration ##
# CORS (Cross-Origin Resource Sharing)
# Comma-separated list of allowed origins
# Development: http://localhost:3000,http://localhost:5173
# Production: https://yourdomain.com
VAULTMIND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Allowed hosts (comma-separated, use * for any)
VAULTMIND_ALLOWED_HOSTS=*

# Maximum request body size (in bytes)
VAULTMIND_MAX_REQUEST_SIZE=52428800  # 50MB

# HSTS (HTTP Strict Transport Security) - Enable for HTTPS deployments
VAULTMIND_ENABLE_HSTS=false
VAULTMIND_HSTS_MAX_AGE=31536000  # 1 year in seconds

# Environment (production|development)
VAULTMIND_ENV=development
