# Auto detect text files and perform LF normalization
* text=auto

# Source code - LF
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.rs text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.c text eol=lf
*.hpp text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf

# Windows scripts - CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.dll binary
*.so binary
*.dylib binary
*.pyd binary
*.exe binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.tar binary
*.gz binary
*.safetensors binary
*.bin binary
*.gguf binary
*.parquet binary
