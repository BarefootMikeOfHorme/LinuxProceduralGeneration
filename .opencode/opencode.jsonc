{
  "$schema": "https://opencode.ai/config.json",
  "watcher": {
    "ignore": [
      ".venv312/**",
      "build/**",
      "dist/**",
      "target/**",
      "**/target/**",
      "output/**",
      "outputs/**",
      "logs/**",
      "uploads/**",
      "**/__pycache__/**",
      ".env",
      ".env.*",
      "!.env.example",
    ],
  },
  "mcp": {
    "timeout": {
      "startup": 60000,
      "catalog": 30000,
      "execution": 600000,
    },
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
      },
      "github-ro": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/readonly",
        "headers": {
          "X-MCP-Toolsets": "context,repos,issues,pull_requests,actions",
          "X-MCP-Readonly": "true",
          "X-MCP-Lockdown": "true",
        },
      },
    },
  },
}
